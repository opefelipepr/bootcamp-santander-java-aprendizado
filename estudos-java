import java.util.Locale;
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in).useLocale(Locale.US);
        int op = 0;
        while (op != 5) {
            System.out.print("\n=== CALCULADORA ===\n1. Soma\n2. Subtração\n3. Multiplicação\n4. Divisão\n5. Sair\nOpção: ");
            if (!sc.hasNextInt()) { sc.next(); continue; }
            op = sc.nextInt();

            if (op >= 1 && op <= 4) {
                if (op == 1 || op == 2) executarSomaSub(sc, op == 1);
                else if (op == 3) System.out.println("Resultado: " + (lerNum(sc) * lerNum(sc)));
                else {
                    double a = lerNum(sc), b = lerNum(sc);
                    if (b == 0) System.out.println("Erro: Divisão por zero!");
                    else System.out.println("Resultado: " + (a / b));
                }
            }
        }
        sc.close();
    }

    private static void executarSomaSub(Scanner sc, boolean isSoma) {
        double res = lerNum(sc);
        res = isSoma ? res + lerNum(sc) : res - lerNum(sc);
        System.out.println("Resultado parcial: " + res);

        int sub = 0;
        while (sub != 2) {
            System.out.print("\n1. Continuar operação\n2. Voltar ao menu\nOpção: ");
            if (!sc.hasNextInt()) { sc.next(); continue; }
            sub = sc.nextInt();
            if (sub == 1) {
                double prox = lerNum(sc);
                res = isSoma ? res + prox : res - prox;
                System.out.println("Resultado: " + res);
            }
        }
    }

    private static double lerNum(Scanner sc) {
        System.out.print("Digite um número: ");
        while (!sc.hasNextDouble()) { sc.next(); System.out.print("Inválido. Digite um número: "); }
        return sc.nextDouble();
    }
}
